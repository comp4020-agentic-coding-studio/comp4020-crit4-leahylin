---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Constellation Composer">
  <header class="visually-hidden">
    <nav aria-label="Primary">
      <a href="./">Constellation Composer</a>
    </nav>
  </header>
  <main>
    <h1 class="visually-hidden">Constellation Composer</h1>
    <div
      id="sky"
      aria-label="Night sky. Click or tab to a star, then another, to connect them into a constellation that plays as a repeating melody. Drag a star, or use arrow keys on a focused star, to change its note. Moving the mouse over empty sky adds a quiet ambient shimmer and a shooting-star trail underneath, once the first click, tap, or key press of a visit has woken the sound."
    >
      <svg id="lines" aria-hidden="true"></svg>
      <p id="hint">click, tap, or tab to a star — then another, to connect them</p>
    </div>
    <div class="controls">
      <button id="clear" type="button">Clear constellation</button>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
